# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kriswin_website?schema=public"

# Public website address (used for SEO / social sharing links)
SITE_URL="https://kriswin-infotech.com"

# Secret used to sign admin session cookies — use a long random string
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# First admin account (created by `npm run db:seed`)
ADMIN_EMAIL="admin@kriswin-infotech.com"
ADMIN_PASSWORD="Admin@123"
